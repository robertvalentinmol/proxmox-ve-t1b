# EI1044 · Grupo T1B · Forma 2 (un portátil): /etc/network/interfaces del nodo pve
# Adaptador 1 de VirtualBox (enp0s3): solo-anfitrión, red del clúster
# Adaptador 2 de VirtualBox (enp0s8): NAT, salida a internet
# En pve2, cambiad 192.168.56.11 por 192.168.56.12.
# Después: /etc/hosts con la misma IP, "nameserver 10.0.2.3" en /etc/resolv.conf e  ifreload -a

auto lo
iface lo inet loopback

iface enp0s3 inet manual

auto vmbr0
iface vmbr0 inet static
        address 192.168.56.11/24
        bridge-ports enp0s3
        bridge-stp off
        bridge-fd 0
# Sin línea gateway en vmbr0: la salida a internet va por enp0s8

auto enp0s8
iface enp0s8 inet static
        address 10.0.2.15/24
        gateway 10.0.2.2
